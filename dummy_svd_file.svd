<?xml version="1.0" encoding="UTF-8"?>
<device xmlns="http://www.arm.com/SVD" schemaVersion="1.0">
    <name>DummyDevice</name>
    <version>1.0</version>
    <description>A large dummy SVD file for testing purposes</description>
    <peripherals>
        <!-- Peripheral 1 -->
        <peripheral>
            <name>PERIPHERAL_1</name>
            <baseAddress>0x40000000</baseAddress>
            <description>Peripheral 1 description</description>
            <registers>
                <register>
                    <name>REG_1_1</name>
                    <addressOffset>0x00</addressOffset>
                    <size>32</size>
                    <access>read-write</access>
                    <description>Register 1.1</description>
                </register>
                <register>
                    <name>REG_1_2</name>
                    <addressOffset>0x04</addressOffset>
                    <size>32</size>
                    <access>read-only</access>
                    <description>Register 1.2</description>
                </register>
                <register>
                    <name>REG_1_3</name>
                    <addressOffset>0x08</addressOffset>
                    <size>32</size>
                    <access>write-only</access>
                    <description>Register 1.3</description>
                </register>
                <register>
                    <name>REG_1_4</name>
                    <addressOffset>0x0C</addressOffset>
                    <size>32</size>
                    <access>read-write</access>
                    <description>Register 1.4</description>
                </register>
                <!-- More registers for PERIPHERAL_1 can be added here -->
            </registers>
        </peripheral>
        
        <!-- Peripheral 2 -->
        <peripheral>
            <name>PERIPHERAL_2</name>
            <baseAddress>0x40001000</baseAddress>
            <description>Peripheral 2 description</description>
            <registers>
                <register>
                    <name>REG_2_1</name>
                    <addressOffset>0x00</addressOffset>
                    <size>32</size>
                    <access>read-write</access>
                    <description>Register 2.1</description>
                </register>
                <register>
                    <name>REG_2_2</name>
                    <addressOffset>0x04</addressOffset>
                    <size>32</size>
                    <access>read-only</access>
                    <description>Register 2.2</description>
                </register>
                <!-- More registers for PERIPHERAL_2 can be added here -->
            </registers>
        </peripheral>
        
        <!-- Additional peripherals can be added similarly to make the file larger -->
        
    </peripherals>
</device>
